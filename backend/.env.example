# Strapi secrets — generate your own, never reuse these
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

NODE_ENV=development

# Database — sqlite for local dev, postgres for production
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Postgres (production) — leave unset for local sqlite dev
# DATABASE_CLIENT=postgres
# DATABASE_HOST=
# DATABASE_PORT=5432
# DATABASE_NAME=
# DATABASE_USERNAME=
# DATABASE_PASSWORD=
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Allowed frontend origins (comma-separated, no trailing slash)
FRONTEND_URLS=http://localhost:3000

# Cloudinary — only needed in production (Render has no persistent disk)
# CLOUDINARY_NAME=
# CLOUDINARY_KEY=
# CLOUDINARY_SECRET=
