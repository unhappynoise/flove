{
  "kind": "collectionType",
  "collectionName": "customer_requests",
  "info": {
    "singularName": "customer-request",
    "pluralName": "customer-requests",
    "displayName": "Customer Request"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "reference": {
      "type": "string",
      "required": true
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "item",
        "general"
      ],
      "default": "item",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "new",
        "confirmed",
        "unavailable",
        "paid",
        "closed"
      ],
      "default": "new",
      "required": true
    },
    "customerName": {
      "type": "string",
      "required": true
    },
    "customerPhone": {
      "type": "string",
      "required": true
    },
    "customerEmail": {
      "type": "email"
    },
    "productId": {
      "type": "string"
    },
    "productName": {
      "type": "string"
    },
    "size": {
      "type": "string"
    },
    "colors": {
      "type": "string"
    },
    "details": {
      "type": "text"
    }
  }
}
